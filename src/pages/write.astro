---
import Layout from '../layouts/Layout.astro';
---

<Layout title="写文章">
  <div class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-2xl font-bold mb-8 dark:text-white">写文章</h1>

    <div class="space-y-6">
      <!-- 标题 -->
      <div>
        <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300">标题</label>
        <input
          type="text"
          id="title"
          placeholder="输入文章标题..."
          class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none"
        />
      </div>

      <!-- 分类和标签 -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300">分类</label>
          <input
            type="text"
            id="category"
            placeholder="随笔"
            value="随笔"
            class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300">标签（用逗号分隔）</label>
          <input
            type="text"
            id="tags"
            placeholder="前端, React"
            class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none"
          />
        </div>
      </div>

      <!-- 摘要 -->
      <div>
        <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300">摘要</label>
        <textarea
          id="excerpt"
          rows="2"
          placeholder="简要描述文章内容..."
          class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none resize-none"
        ></textarea>
      </div>

      <!-- 正文 -->
      <div>
        <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300">正文（Markdown）</label>
        <textarea
          id="content"
          rows="16"
          placeholder="用 Markdown 写文章内容..."
          class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none resize-none font-mono text-sm"
        ></textarea>
      </div>

      <!-- 预览按钮 -->
      <div class="flex gap-4">
        <button
          id="previewBtn"
          class="px-6 py-2.5 border border-neutral-300 dark:border-neutral-600 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-colors text-neutral-700 dark:text-neutral-300"
        >
          预览效果
        </button>
        <button
          id="copyBtn"
          class="px-6 py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-lg transition-colors"
        >
          复制 Markdown
        </button>
      </div>

      <!-- 预览区 -->
      <div id="preview" class="hidden p-6 border border-neutral-200 dark:border-neutral-700 rounded-lg bg-neutral-50 dark:bg-neutral-900">
        <h2 class="text-xl font-bold mb-4 text-neutral-900 dark:text-white">预览</h2>
        <div id="previewContent" class="prose dark:prose-invert max-w-none"></div>
      </div>

      <!-- 下载按钮 -->
      <div id="downloadSection" class="hidden">
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
          <p class="text-green-700 dark:text-green-400 text-sm mb-3">
            复制成功！现在手动保存到文件：
          </p>
          <code class="block bg-white dark:bg-neutral-800 p-3 rounded text-xs text-neutral-600 dark:text-neutral-400 break-all">
            src/content/posts/<span id="filename"></span>
          </code>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { marked } from 'marked';

  const titleInput = document.getElementById('title') as HTMLInputElement;
  const categoryInput = document.getElementById('category') as HTMLInputElement;
  const tagsInput = document.getElementById('tags') as HTMLInputElement;
  const excerptInput = document.getElementById('excerpt') as HTMLTextAreaElement;
  const contentInput = document.getElementById('content') as HTMLTextAreaElement;
  const previewBtn = document.getElementById('previewBtn')!;
  const copyBtn = document.getElementById('copyBtn')!;
  const previewDiv = document.getElementById('preview')!;
  const previewContent = document.getElementById('previewContent')!;
  const downloadSection = document.getElementById('downloadSection')!;
  const filenameSpan = document.getElementById('filename')!;

  function generateMarkdown() {
    const title = titleInput.value || '无标题';
    const category = categoryInput.value || '未分类';
    const tagsRaw = tagsInput.value || '';
    const tags = tagsRaw ? `[${tagsRaw.split(',').map(t => `"${t.trim()}"`).join(', ')}]` : '[]';
    const excerpt = excerptInput.value || '';
    const content = contentInput.value || '';

    const date = new Date().toISOString().split('T')[0];
    const slug = title.toLowerCase().replace(/[^\w\u4e00-\u9fa5]/g, '-').replace(/-+/g, '-');
    const filename = `${date}-${slug}.md`;

    return {
      filename,
      markdown: `---
title: ${title}
date: ${date}
category: ${category}
tags: ${tags}
excerpt: ${excerpt}
---

${content}`
    };
  }

  previewBtn.addEventListener('click', () => {
    const { markdown } = generateMarkdown();
    const content = markdown.split('---')[2]?.trim() || '';
    previewContent.innerHTML = marked.parse(content) as string;
    previewDiv.classList.remove('hidden');
  });

  copyBtn.addEventListener('click', async () => {
    const { filename, markdown } = generateMarkdown();
    await navigator.clipboard.writeText(markdown);
    filenameSpan.textContent = filename;
    downloadSection.classList.remove('hidden');

    titleInput.focus();
  });
</script>

<style>
  /* Markdown 预览样式 */
  .prose h1 { @apply text-2xl font-bold mb-4 mt-6 text-neutral-900 dark:text-white; }
  .prose h2 { @apply text-xl font-bold mb-3 mt-5 text-neutral-900 dark:text-white; }
  .prose h3 { @apply text-lg font-bold mb-2 mt-4 text-neutral-900 dark:text-white; }
  .prose p { @apply mb-4 leading-relaxed text-neutral-700 dark:text-neutral-300; }
  .prose ul { @apply list-disc pl-6 mb-4 space-y-1; }
  .prose ol { @apply list-decimal pl-6 mb-4 space-y-1; }
  .prose li { @apply text-neutral-700 dark:text-neutral-300; }
  .prose code { @apply bg-neutral-100 dark:bg-neutral-800 px-1.5 py-0.5 rounded text-sm font-mono text-orange-600 dark:text-orange-400; }
  .prose pre { @apply bg-neutral-100 dark:bg-neutral-800 p-4 rounded-lg mb-4 overflow-x-auto; }
  .prose pre code { @apply bg-transparent p-0; }
  .prose blockquote { @apply border-l-4 border-orange-500 pl-4 italic text-neutral-600 dark:text-neutral-400 my-4; }
  .prose a { @apply text-orange-500 hover:underline; }
  .prose img { @apply rounded-lg max-w-full; }
  .prose hr { @apply border-neutral-200 dark:border-neutral-700 my-8; }
</style>

---
import Layout from '../layouts/Layout.astro';
import { site } from '../site';
---
<Layout title={`404 - ${site.name}`} description="页面不存在">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <div class="rounded-xl border border-dashed border-neutral-300 bg-white px-10 py-12 dark:border-neutral-700 dark:bg-neutral-900">
      <div class="font-mono text-6xl font-bold text-orange-500">404</div>
      <p class="mt-4 text-neutral-500 dark:text-neutral-400">页面不存在或已被移动</p>
      <a
        href="/"
        class="mt-8 inline-block rounded-full bg-neutral-900 px-6 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-80 dark:bg-white dark:text-neutral-900"
      >
        回到首页
      </a>
    </div>
  </div>
</Layout>

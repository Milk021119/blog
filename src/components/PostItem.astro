---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, date, category, tags, excerpt } = post.data;
const fmt = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---
<div class="relative border border-transparent border-dashed cursor-pointer px-6 py-5 md:p-7 group rounded-2xl" data-post-card>
  <div class="absolute inset-0 z-20 w-full h-full duration-300 ease-out bg-white border border-dashed dark:bg-neutral-950 rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:-translate-x-1 group-hover:-translate-y-1"></div>
  <div class="absolute inset-0 z-10 w-full h-full duration-300 ease-out border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:translate-x-1 group-hover:translate-y-1"></div>
  <a href={`/posts/${post.id}`} class="flex relative z-30 duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
    <div class="flex-1">
      <h2 class="flex items-center mb-3">
        <span class="text-lg font-bold leading-tight tracking-tight sm:text-xl dark:text-neutral-100">{title}</span>
        <svg class="group-hover:translate-x-0 flex-shrink-0 translate-y-0.5 -translate-x-1 w-2.5 h-2.5 stroke-current ml-1 transition-all ease-in-out duration-200 transform" viewBox="0 0 13 15" xmlns="http://www.w3.org/2000/svg"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"><g transform="translate(0.666667, 2.333333)" stroke="currentColor" stroke-width="2.4"><g><polyline class="transition-all duration-200 ease-out opacity-0 delay-0 group-hover:opacity-100" points="5.33333333 0 10.8333333 5.5 5.33333333 11"></polyline><line class="transition-all duration-200 ease-out transform -translate-x-1 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 group-hover:ml-0" x1="10.8333333" y1="5.5" x2="0.833333333" y2="5.16666667"></line></g></g></g></svg>
      </h2>
      {excerpt && (
        <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 break-all"><span>{excerpt}</span></p>
      )}
      <div class="mt-2.5 text-xs font-medium text-neutral-800 dark:text-neutral-300">
        {fmt(date)} ·
        <a href={`/category/${encodeURIComponent(category)}`} class="hover:underline decoration-dashed underline-offset-4">{category}</a>
        {tags.length > 0 && (
          <span> · <span class="inline-flex flex-wrap gap-1">
            {tags.map((tag) => (
              <a href={`/tag/${encodeURIComponent(tag)}`} class="hover:underline decoration-dashed underline-offset-4">#{tag}</a>
            ))}
          </span></span>
        )}
      </div>
    </div>
  </a>
</div>

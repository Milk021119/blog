---
interface Props {
  text?: string;
  size?: number;
  spinDuration?: number;
  reverse?: boolean;
  centerIcon?: boolean;
}
const {
  text = 'MILK • BLOG • MILK • BLOG • ',
  size = 110,
  spinDuration = 14,
  reverse = false,
  centerIcon = true,
} = Astro.props;

const r = 50;               // SVG 视图半径（viewBox 坐标系）
const pathId = `circle-${Math.random().toString(36).slice(2, 8)}`;
---
<div
  class="circular-text"
  style={`width:${size}px;height:${size}px;`}
  role="img"
  aria-label={text}
>
  <svg
    viewBox="0 0 100 100"
    class:list={['circular-text__ring', reverse && 'is-reverse']}
    style={`animation-duration:${spinDuration}s;`}
  >
    <defs>
      <!-- 圆形路径：圆心 (50,50)，半径 40 -->
      <path id={pathId} d="M 50,50 m -40,0 a 40,40 0 1,1 80,0 a 40,40 0 1,1 -80,0" fill="none" />
    </defs>
    <text class="circular-text__letters">
      <textPath href={`#${pathId}`}>{text}</textPath>
    </text>
  </svg>
  {centerIcon && (
    <span class="circular-text__center" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7M8 7h9v9" />
      </svg>
    </span>
  )}
</div>

<style is:global>
  .circular-text {
    position: relative;
    display: grid;
    place-items: center;
    color: var(--color-neutral-900);
  }
  :global(.dark) .circular-text {
    color: var(--color-neutral-100);
  }

  /* 外圈文字：匀速无限旋转 */
  .circular-text__ring {
    width: 100%;
    height: 100%;
    animation-name: circular-rotate;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    transform-origin: 50% 50%;
  }
  .circular-text__ring.is-reverse {
    animation-direction: reverse;
  }
  @keyframes circular-rotate {
    to { transform: rotate(360deg); }
  }

  .circular-text__letters {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    fill: currentColor;
    font-family: inherit;
  }

  /* 中心箭头 */
  .circular-text__center {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 34%;
    height: 34%;
    display: grid;
    place-items: center;
    color: var(--color-orange-500);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .circular-text:hover .circular-text__center {
    transform: rotate(45deg) scale(1.15);
  }
  .circular-text__center svg {
    width: 100%;
    height: 100%;
  }

  /* 减少动画偏好 */
  @media (prefers-reduced-motion: reduce) {
    .circular-text__ring { animation: none; }
  }
</style>

---
---
<div class="target-cursor-wrapper" id="tc-wrapper" aria-hidden="true">
  <div class="target-cursor-dot" id="tc-dot"></div>
  <div class="target-cursor-corner corner-tl"></div>
  <div class="target-cursor-corner corner-tr"></div>
  <div class="target-cursor-corner corner-br"></div>
  <div class="target-cursor-corner corner-bl"></div>
</div>

<style is:global>
  .target-cursor-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 9999;
    mix-blend-mode: difference;
    opacity: 0;
    transition: opacity 0.25s ease;
    will-change: transform;
  }
  .target-cursor-wrapper.is-visible { opacity: 1; }

  .target-cursor-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    background: #fff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  .target-cursor-corner {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    border: 3px solid #fff;
    will-change: transform;
  }
  .corner-tl { border-right: none; border-bottom: none; }
  .corner-tr { border-left: none; border-bottom: none; }
  .corner-br { border-left: none; border-top: none; }
  .corner-bl { border-right: none; border-top: none; }

  body.has-target-cursor,
  body.has-target-cursor a,
  body.has-target-cursor button,
  body.has-target-cursor input,
  body.has-target-cursor [data-post-card] {
    cursor: none;
  }
</style>

<script>
  import { gsap } from 'gsap';

  (() => {
    const fine = matchMedia('(pointer: fine)').matches && matchMedia('(hover: hover)').matches;
    if (!fine || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const wrapper = document.getElementById('tc-wrapper');
    const dot = document.getElementById('tc-dot');
    if (!wrapper || !dot) return;
    const corners = [...wrapper.querySelectorAll('.target-cursor-corner')];

    document.body.classList.add('has-target-cursor');

    const BORDER = 3, CORNER = 12, SPIN_DURATION = 2, HOVER_DURATION = 0.2;
    const DEFAULT_POS = [
      { x: -CORNER * 1.5, y: -CORNER * 1.5 },
      { x:  CORNER * 0.5, y: -CORNER * 1.5 },
      { x:  CORNER * 0.5, y:  CORNER * 0.5 },
      { x: -CORNER * 1.5, y:  CORNER * 0.5 },
    ];

    let activeTarget = null;
    let targetCornerPositions = null;   // 元素四角（视口坐标）
    let activeStrength = { current: 0 };// 吸附强度 0→1（弹性来源）
    let spinTl = null;
    let tickerFn = null;
    let currentLeaveHandler = null;
    let resumeTimeout = null;

    gsap.set(wrapper, {
      xPercent: -50, yPercent: -50,
      x: innerWidth / 2, y: innerHeight / 2,
    });
    corners.forEach((c, i) => gsap.set(c, { x: DEFAULT_POS[i].x, y: DEFAULT_POS[i].y }));

    const xTo = gsap.quickTo(wrapper, 'x', { duration: 0.1, ease: 'power3.out' });
    const yTo = gsap.quickTo(wrapper, 'y', { duration: 0.1, ease: 'power3.out' });
    const moveCursor = (x, y) => { xTo(x); yTo(y); };

    const createSpinTimeline = () => {
      spinTl?.kill();
      spinTl = gsap.timeline({ repeat: -1 })
        .to(wrapper, { rotation: '+=360', duration: SPIN_DURATION, ease: 'none' });
    };
    createSpinTimeline();

    tickerFn = () => {
      if (!targetCornerPositions || !wrapper || !corners.length) return;
      const strength = activeStrength.current;
      if (strength === 0) return;

      const cursorX = gsap.getProperty(wrapper, 'x');
      const cursorY = gsap.getProperty(wrapper, 'y');

      corners.forEach((corner, i) => {
        const currentX = gsap.getProperty(corner, 'x');
        const currentY = gsap.getProperty(corner, 'y');
        const targetX = targetCornerPositions[i].x - cursorX;
        const targetY = targetCornerPositions[i].y - cursorY;
        const finalX = currentX + (targetX - currentX) * strength;
        const finalY = currentY + (targetY - currentY) * strength;
        const duration = strength >= 0.99 ? 0.2 : 0.05;  // parallaxOn
        gsap.to(corner, {
          x: finalX, y: finalY,
          duration, ease: duration === 0 ? 'none' : 'power1.out',
          overwrite: 'auto',
        });
      });
    };

    const moveHandler = (e) => {
      moveCursor(e.clientX, e.clientY);
      if (!wrapper.classList.contains('is-visible')) wrapper.classList.add('is-visible');
    };

    const scrollHandler = () => {
      if (!activeTarget || !wrapper) return;
      const mouseX = gsap.getProperty(wrapper, 'x');
      const mouseY = gsap.getProperty(wrapper, 'y');
      const el = document.elementFromPoint(mouseX, mouseY);
      const stillOver = el && (el === activeTarget || el.closest('a, button, input, [data-post-card], [role="button"]') === activeTarget);
      if (!stillOver && currentLeaveHandler) currentLeaveHandler();
    };

    const downHandler = () => {
      gsap.to(dot, { scale: 0.7, duration: 0.3 });
      gsap.to(wrapper, { scale: 0.9, duration: 0.2 });
    };
    const upHandler = () => {
      gsap.to(dot, { scale: 1, duration: 0.3 });
      gsap.to(wrapper, { scale: 1, duration: 0.2 });
    };

    const enterHandler = (e) => {
      const target = e.target.closest('a, button, input, [data-post-card], [role="button"]');
      if (!target || target === activeTarget) return;
      if (activeTarget && currentLeaveHandler) {
        activeTarget.removeEventListener('mouseleave', currentLeaveHandler);
        currentLeaveHandler = null;
      }
      if (resumeTimeout) { clearTimeout(resumeTimeout); resumeTimeout = null; }

      activeTarget = target;
      corners.forEach(c => gsap.killTweensOf(c, 'x,y'));
      gsap.killTweensOf(wrapper, 'rotation');
      spinTl?.pause();
      gsap.set(wrapper, { rotation: 0 });

      const rect = target.getBoundingClientRect();
      targetCornerPositions = [
        { x: rect.left - BORDER, y: rect.top - BORDER },
        { x: rect.right + BORDER - CORNER, y: rect.top - BORDER },
        { x: rect.right + BORDER - CORNER, y: rect.bottom + BORDER - CORNER },
        { x: rect.left - BORDER, y: rect.bottom + BORDER - CORNER },
      ];

      gsap.ticker.add(tickerFn);
      gsap.to(activeStrength, { current: 1, duration: HOVER_DURATION, ease: 'power2.out' });

      const cursorX = gsap.getProperty(wrapper, 'x');
      const cursorY = gsap.getProperty(wrapper, 'y');
      corners.forEach((corner, i) => {
        gsap.to(corner, {
          x: targetCornerPositions[i].x - cursorX,
          y: targetCornerPositions[i].y - cursorY,
          duration: 0.2, ease: 'power2.out',
        });
      });

      const leaveHandler = () => {
        gsap.ticker.remove(tickerFn);
        targetCornerPositions = null;
        gsap.set(activeStrength, { current: 0, overwrite: true });
        activeTarget = null;

        corners.forEach(c => gsap.killTweensOf(c, 'x,y'));
        corners.forEach((corner, i) => {
          gsap.to(corner, {
            x: DEFAULT_POS[i].x, y: DEFAULT_POS[i].y,
            duration: 0.3, ease: 'power3.out',
          });
        });

        resumeTimeout = setTimeout(() => {
          if (!activeTarget && spinTl) {
            const currentRotation = gsap.getProperty(wrapper, 'rotation');
            const normalized = currentRotation % 360;
            spinTl.kill();
            spinTl = gsap.timeline({ repeat: -1 })
              .to(wrapper, { rotation: '+=360', duration: SPIN_DURATION, ease: 'none' });
            gsap.to(wrapper, {
              rotation: normalized + 360,
              duration: SPIN_DURATION * (1 - normalized / 360),
              ease: 'none',
              onComplete: () => spinTl?.restart(),
            });
          }
          resumeTimeout = null;
        }, 50);

        target.removeEventListener('mouseleave', leaveHandler);
        currentLeaveHandler = null;
      };

      currentLeaveHandler = leaveHandler;
      target.addEventListener('mouseleave', leaveHandler);
    };

    addEventListener('mousemove', moveHandler, { passive: true });
    addEventListener('mouseover', enterHandler, { passive: true });
    addEventListener('scroll', scrollHandler, { passive: true });
    addEventListener('mousedown', downHandler);
    addEventListener('mouseup', upHandler);
    document.documentElement.addEventListener('mouseleave', () => wrapper.classList.remove('is-visible'));
  })();
</script>
